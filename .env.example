# ── JARVIS Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git!

# ── Speech-to-Text (Deepgram) ──────────────────────────────────────────────────
# Get a free key at https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── LLM – Google Gemini (FREE, recommended) ───────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── LLM – OpenAI (optional fallback) ─────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Text-to-Speech ─────────────────────────────────────────────────────────────
# ElevenLabs is optional — Edge-TTS is used automatically (completely free)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Web Dashboard ─────────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
